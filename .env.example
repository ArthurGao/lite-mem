# Copy to .env (gitignored). Every setting has the LITEMEM_ prefix; nested keys use "__".
LITEMEM_DATABASE_URL=postgresql://lite_mem:CHANGE_ME@localhost:5432/lite_mem
# Tests use their own schema (lite_mem_test, dropped and recreated); set explicitly, never inherited.
LITEMEM_TEST_DATABASE_URL=postgresql://lite_mem:CHANGE_ME@localhost:5432/lite_mem
LITEMEM_NAMESPACE=app
# Defaults: Ollama on the host for both (bge-m3:567m embeddings, qwen3:8b for every role).
# LITEMEM_LLM__BASE_URL=http://127.0.0.1:11434/v1
# LITEMEM_LLM__MODEL=qwen3:8b
# LITEMEM_LLM__ROLES={"resolve": "qwen3:8b"}
