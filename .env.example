# Copy to .env (gitignored). Every setting has the LITEMEM_ prefix; nested keys use "__".
LITEMEM_DATABASE_URL=postgresql://lite_mem:CHANGE_ME@localhost:5432/lite_mem
# or, without a database server (extra `sqlite`): LITEMEM_DATABASE_URL=sqlite:///./memory.db
# Tests use their own schema (lite_mem_test, dropped and recreated); set explicitly, never inherited.
LITEMEM_TEST_DATABASE_URL=postgresql://lite_mem:CHANGE_ME@localhost:5432/lite_mem
LITEMEM_NAMESPACE=app
# Defaults: Ollama on the host for both (bge-m3:567m embeddings, qwen3:8b for every role).
# Embeddings are lite-model's too (an embed role; S14). The backend name is the index's provider:
# LITEMEM_EMBEDDING__BACKEND=ollama
# LITEMEM_EMBEDDING__MODEL=bge-m3:567m
# LITEMEM_EMBEDDING__DIM=1024              # skips learning it from the first reply
# The LLM settings are lite-model's (its README "Configuration"); the default backend is named
# `openai` (the history records openai:<model>): Ollama's /v1, no key.
# LITEMEM_LLM__MODEL=qwen3:8b
# LITEMEM_LLM__REASONING_EFFORT=none       # qwen3: thinking off, ~20x faster
# LITEMEM_LLM__ROLES='{"resolve": {"model": "qwen3:8b"}}'
# Another endpoint: name a backend; keys only through the variable it names (never the value here).
# LITEMEM_LLM__BACKENDS='{"deepseek": {"type": "openai", "base_url": "https://api.deepseek.com/v1", "api_key_env": "DEEPSEEK_API_KEY"}}'
# LITEMEM_LLM__ROLES='{"resolve": {"backend": "deepseek", "model": "deepseek-chat"}}'
# Anthropic (extra `anthropic`, key in ANTHROPIC_API_KEY) needs an output limit; lite-mem used 2048:
# LITEMEM_LLM__ROLES='{"resolve": {"backend": "anthropic", "model": "claude-…", "max_output_tokens": 2048}}'
# Only the local endpoint (compose does this for Docker): LITEMEM_LLM__BACKENDS__OPENAI__BASE_URL=http://…/v1
# The HTTP service (`litemem serve`, port 8710). Without keys it serves loopback clients only.
# Make a key with `uv run litemem key new <name> -n '<namespace glob>'` and paste its entry here:
# LITEMEM_SERVER__API_KEYS='[{"id": "app", "sha256": "…", "namespaces": ["app"]}]'
# docker compose (deploy/compose.yaml) also needs the password of its own PostgreSQL:
# POSTGRES_PASSWORD=CHANGE_ME
